<view class="container">
  <form bindsubmit="onSubmit">
    <view>
      <text>收件人</text>
      <input name="recipient" placeholder="请输入收件人" />
    </view>
    <view>
      <text>手机号</text>
      <input name="phone" placeholder="请输入手机号" />
    </view>
    <view>
      <text>省</text>
      <input name="province" placeholder="请输入省份" />
    </view>
    <view>
      <text>市</text>
      <input name="city" placeholder="请输入城市" />
    </view>
    <view>
      <text>区</text>
      <input name="district" placeholder="请输入区县" />
    </view>
    <view>
      <text>详细地址</text>
      <input name="address" placeholder="请输入详细地址" />
    </view>
    <view>
      <text>备注</text>
      <input name="remark" placeholder="请输入备注（选填）" />
    </view>
    <button type="primary" formType="submit">提交地址</button>
  </form>
</view>
