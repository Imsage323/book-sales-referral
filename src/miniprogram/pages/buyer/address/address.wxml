<view class="container">
  <view class="purpose-card">
    <view class="purpose-mark">收</view>
    <view class="purpose-content">
      <view class="purpose-title">收货信息仅用于订单履约</view>
      <view class="purpose-copy">姓名、手机号和地址用于寄送图书、物流查询与必要售后，不用于营销外呼。</view>
      <text class="purpose-link" bindtap="openPrivacyContract">查看《{{privacyContractName}}》</text>
    </view>
  </view>

  <view class="paste-card">
    <view class="paste-title">一键粘贴识别</view>
    <view class="paste-hint">复制整段地址（含街道后的路名门牌），粘贴后点识别。例：张三 13800138000 陕西省西安市长安区韦曲街道xx路xx号</view>
    <textarea
      class="paste-area"
      maxlength="500"
      placeholder="例如：张三 13800138000 广东省深圳市南山区科技园南路1号"
      value="{{pasteText}}"
      bindinput="onPasteInput"
    ></textarea>
    <view class="paste-actions">
      <button class="btn-clip" bindtap="onPasteFromClipboard">从剪贴板粘贴</button>
      <button class="btn-parse" bindtap="onRecognize">识别填入</button>
    </view>
  </view>

  <view class="field">
    <text class="label">收件人</text>
    <input value="{{recipient}}" bindinput="onFieldInput" data-field="recipient" placeholder="请输入收件人" />
  </view>
  <view class="field">
    <text class="label">手机号</text>
    <input type="number" value="{{phone}}" bindinput="onFieldInput" data-field="phone" placeholder="请输入手机号" />
  </view>
  <view class="field">
    <text class="label">省</text>
    <input value="{{province}}" bindinput="onFieldInput" data-field="province" placeholder="请输入省份" />
  </view>
  <view class="field">
    <text class="label">市</text>
    <input value="{{city}}" bindinput="onFieldInput" data-field="city" placeholder="请输入城市" />
  </view>
  <view class="field">
    <text class="label">区</text>
    <input value="{{district}}" bindinput="onFieldInput" data-field="district" placeholder="请输入区县" />
  </view>
  <view class="field">
    <text class="label">详细地址</text>
    <input value="{{addressDetail}}" bindinput="onFieldInput" data-field="addressDetail" placeholder="请输入详细地址" />
  </view>
  <view class="field">
    <text class="label">备注（选填）</text>
    <input value="{{remark}}" bindinput="onFieldInput" data-field="remark" placeholder="请输入备注" />
  </view>

  <button class="btn-submit" type="primary" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交地址</button>
  <button class="contact-btn" open-type="contact">遇到问题，联系微信客服</button>

  <view wx:if="{{showPrivacyPrompt}}" class="privacy-mask" catchtouchmove="noop">
    <view class="privacy-sheet">
      <view class="privacy-title">是否允许读取剪贴板？</view>
      <view class="privacy-copy">仅在本次点击后读取剪贴板中的地址文本并在本机解析；拒绝后仍可粘贴到文本框或手工填写。</view>
      <text class="purpose-link" bindtap="openPrivacyContract">查看《{{privacyContractName}}》</text>
      <view class="privacy-actions">
        <button class="privacy-later" bindtap="onDeclinePrivacy">不用剪贴板</button>
        <button
          class="privacy-agree"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
        >同意并读取</button>
      </view>
    </view>
  </view>
</view>
