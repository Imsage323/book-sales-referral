page {
  background: #fff9f2;
  color: #2b2b2b;
}

.pay-wrap {
  padding: 16px;
}

.amount-card {
  background: #fff;
  border-radius: 12px;
  padding: 28px 16px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(240, 124, 36, 0.06);
}

.amount-label {
  color: #8a8a8a;
  font-size: 13px;
}

.amount-line {
  margin-top: 8px;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.currency {
  color: #f07c24;
  font-size: 22px;
  font-weight: 600;
  margin-right: 2px;
}

.amount {
  color: #f07c24;
  font-size: 44px;
  font-weight: 700;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 4px 16px;
  margin-top: 12px;
  box-shadow: 0 2px 8px rgba(240, 124, 36, 0.06);
}

.pay-row {
  display: flex;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom: 1px solid #f6efe7;
  font-size: 14px;
}

.pay-row:last-child {
  border-bottom: none;
}

.label {
  color: #8a8a8a;
}

.value {
  color: #2b2b2b;
}

.hint {
  color: #8a8a8a;
  font-size: 12px;
  text-align: center;
  margin: 20px 0;
}

.pay-btn {
  background: #f07c24;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  border-radius: 24px;
  height: 46px;
  line-height: 46px;
}

.pay-btn::after {
  border: none;
}

.pay-btn.button-hover {
  background: #d96a1b;
}

.cancel-btn {
  background: transparent;
  color: #8a8a8a;
  font-size: 14px;
  margin-top: 12px;
}

.cancel-btn::after {
  border: none;
}

.state-tip {
  text-align: center;
  color: #8a8a8a;
  padding: 60px 0;
}
