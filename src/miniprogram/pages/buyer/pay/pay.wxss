.container {
  padding: 20px;
}

.pay-card {
  background: #fff;
  border-radius: 8px;
  padding: 24px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.pay-title {
  font-size: 18px;
  text-align: center;
  margin-bottom: 16px;
  color: #333;
}

.pay-amount {
  text-align: center;
  margin-bottom: 24px;
}

.currency {
  font-size: 20px;
  color: #ff4d4f;
  vertical-align: top;
}

.amount {
  font-size: 40px;
  color: #ff4d4f;
  font-weight: bold;
}

.pay-row {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 14px;
  color: #666;
}

.label {
  color: #999;
}

.notice {
  margin: 20px 0;
  padding: 12px;
  background: #fff7e6;
  color: #d48806;
  font-size: 13px;
  border-radius: 4px;
  line-height: 1.5;
}

button {
  margin-top: 16px;
}

.cancel-btn {
  background: #fff;
  color: #666;
  border: 1px solid #d9d9d9;
}
