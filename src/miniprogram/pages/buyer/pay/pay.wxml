<view class="container">
  <view wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{order}}" class="pay-card">
    <view class="pay-title">订单支付</view>
    <view class="pay-amount">
      <text class="currency">¥</text>
      <text class="amount">{{order.totalAmount / 100}}</text>
    </view>
    <view class="pay-row">
      <text class="label">订单号</text>
      <text>{{order.orderNo}}</text>
    </view>
    <view class="pay-row">
      <text class="label">数量</text>
      <text>{{order.quantity}} 本</text>
    </view>
    <view class="pay-row">
      <text class="label">状态</text>
      <text>{{order.status}}</text>
    </view>

    <view class="notice">当前为模拟支付环境，未接入真实微信支付。点击“模拟支付”将继续填写收货地址。</view>

    <button type="primary" bindtap="onPay" loading="{{paying}}" disabled="{{paying}}">模拟支付</button>
    <button class="cancel-btn" bindtap="onCancel" disabled="{{paying}}">暂不支付</button>
  </view>

  <view wx:else>
    <text>未找到订单</text>
  </view>
</view>
