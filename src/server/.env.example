# 微信云托管生产环境示例
# 注意：不要在仓库中提交真实密码，这些值只在云托管控制台环境变量中配置

NODE_ENV=production
PORT=3000

DB_HOST=10.6.104.130
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_NAME=book_sales

JWT_SECRET=replace_with_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
BUYER_JWT_EXPIRES_IN=2h

# 管理后台与 API 同源部署时可留空；跨域开发/独立后台用逗号分隔显式列出
CORS_ORIGINS=

# 一次性创建生产管理员时临时设置，执行 npm run admin:create 后立即移除
ADMIN_INITIAL_USERNAME=replace_with_admin_username
ADMIN_INITIAL_PASSWORD=replace_with_random_password_at_least_12_chars

# 普通入口必须显式绑定直营销售方和默认在售商品；缺失时接口返回 503
DEFAULT_SELLER_CODE=replace_with_direct_seller_code
DEFAULT_PRODUCT_ID=replace_with_product_uuid

# 微信支付 / 微信登录
# 生产环境只允许 real；mock 仅可在 NODE_ENV=development/test 时显式启用
WX_LOGIN_MODE=real
WX_PAY_MODE=real
WX_APPID=your_miniprogram_appid
WX_SECRET=your_miniprogram_appsecret
WX_MCHID=your_merchant_id
WX_PAY_SERIAL_NO=your_merchant_certificate_serial_no
WX_PAY_APIV3_KEY=your_apiv3_key_32_bytes
# PEM 内容单行存储，换行用 \n 转义
WX_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WX_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_xxxx
WX_PAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
WX_PAY_NOTIFY_URL=https://your-domain/api/wx/notify
